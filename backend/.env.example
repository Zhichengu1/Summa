# Summa backend — environment template. Copy to backend/.env and fill in.
# backend/.env is gitignored; NEVER commit real values. (CI scans for leaks.)

# --- Supabase ---------------------------------------------------------------
# Use the service_role key (bypasses RLS). Never expose it in the frontend.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key-here

# --- SEC EDGAR fair access --------------------------------------------------
# Required User-Agent identifying your app to SEC. Format: "Name email".
EDGAR_IDENTITY=Summa/1.0 (your@email.com)
# Requests/sec throttle. edgartools defaults to 9 (SEC's ~10/s ceiling); read at
# import time. Leave at 9 for SEC's servers — only raise for an authorized mirror.
EDGAR_RATE_LIMIT_PER_SEC=9

# --- Ingest tuning (optional; code defaults shown) --------------------------
# INGEST_MAX_PER_RUN=25         # companies visited per run
# INGEST_TIME_BUDGET_S=420      # wall-clock budget before the run stops starting work
# INTERVAL_FUNDAMENTALS=168     # per-dataset cadence overrides (hours), etc.

# --- Phase 2 enrichment (optional; not used by the Phase 1 ingest) ----------
GEMINI_API_KEY=
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=
