# Supabase — use the service_role key (bypasses RLS; never expose in frontend)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Identifies your app to SEC EDGAR (required by SEC fair-access policy)
# Format: "AppName/Version (contact@email.com)"
EDGAR_IDENTITY=Summa/1.0 (your@email.com)

# Optional — Stage 2 enrichment. Without it, signal data is still written,
# just without Gemini narrative summaries. Get one at aistudio.google.com.
GEMINI_API_KEY=

# Optional — real-time alerts for flagged filings + monthly digest.
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=
