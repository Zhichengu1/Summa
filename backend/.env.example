# Summa backend environment — copy to backend/.env (gitignored) and fill in.
# All credentials come from env vars; nothing is hardcoded (invariant #9).

# --- Required (Phase 1 ingest) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY            # service_role, NOT the anon key
EDGAR_IDENTITY="Summa/1.0 (you@example.com)"  # SEC fair-access User-Agent

# --- Optional (notification channels) ---
# Discord webhook for filing/news alerts. Absent → alerts are a silent no-op.
DISCORD_WEBHOOK_URL=

# --- Tuning (defaults shown; uncomment to override) ---
# INGEST_MAX_PER_RUN=12
# INGEST_TIME_BUDGET_S=360
# EDGAR_RATE_LIMIT_PER_SEC=9
