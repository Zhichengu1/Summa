# Summa frontend — environment template. Copy to frontend/.env.local and fill in.
# frontend/.env.local is gitignored; NEVER commit real values.

# Supabase ANON key only (RLS-restricted to SELECT on warehouse tables +
# SELECT/INSERT on `watchlist`). The service_role key must NEVER be set here.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
