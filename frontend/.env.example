# Supabase — the PUBLIC project URL and the ANON (public) key.
# Safe to ship to the browser: the anon key has SELECT-only access under RLS
# (see schema.sql). NEVER put the service_role key here — that one is backend-only.
# Find both in: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
