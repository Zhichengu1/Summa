#!/usr/bin/env bash
# Summa pre-commit secret guard.
# Blocks a commit if staged changes contain credential-like patterns or an .env
# file. Uses gitleaks if installed; otherwise falls back to a built-in grep scan.
#
# Enable once per clone:   git config core.hooksPath .githooks
set -euo pipefail

# 1. Never allow a real env file to be staged (templates are fine).
staged_files=$(git diff --cached --name-only --diff-filter=ACM)
if echo "$staged_files" | grep -E '(^|/)\.env($|\.)' | grep -vE '\.env\.example$' | grep -q .; then
  echo "✖ pre-commit: refusing to commit an .env file:"
  echo "$staged_files" | grep -E '(^|/)\.env($|\.)' | grep -vE '\.env\.example$' | sed 's/^/    /'
  echo "  These are gitignored for a reason. Remove with: git rm --cached <file>"
  exit 1
fi

# 2. Prefer gitleaks if available (uses .gitleaks.toml).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --config .gitleaks.toml
  exit $?
fi

# 3. Fallback: grep staged diff for high-signal secret patterns.
patterns='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}|AIzaSy[A-Za-z0-9_-]{33}|discord(app)?\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+|sk-[A-Za-z0-9]{32,}'
if git diff --cached -U0 | grep -nE "$patterns" | grep -vE 'your-service-role-key-here|xxxxxxxxxxxx\.supabase\.co' | grep -q .; then
  echo "✖ pre-commit: a credential-like string was found in your staged changes:"
  git diff --cached -U0 | grep -nE "$patterns" | grep -vE 'your-service-role-key-here|xxxxxxxxxxxx\.supabase\.co' | sed 's/^/    /'
  echo "  If this is a false positive, commit with: git commit --no-verify"
  exit 1
fi

exit 0
