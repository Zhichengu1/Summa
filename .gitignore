# =============================================================================
# Summa — .gitignore
# Covers: Python backend, Next.js frontend, environment credentials, OS/editor
# =============================================================================

# -----------------------------------------------------------------------------
# Credentials — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
scraper/.env
frontend/.env.local

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
venv/
.venv/
env/
.env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Test & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.lcov

# Type checking
.mypy_cache/
.pytype/
*.tsbuildinfo

# Jupyter
.ipynb_checkpoints/

# spaCy model downloads (large binary, re-downloadable via `python -m spacy download`)
# Uncomment if you ever store a model locally rather than relying on the package install
# en_core_web_md/

# -----------------------------------------------------------------------------
# Node.js / Next.js
# -----------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.vercel/
.cache/

# Build output
frontend/out/
frontend/.next/

# npm / yarn / pnpm lock files — keep package-lock.json but ignore others
yarn.lock
pnpm-lock.yaml
.yarn/

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Editors & IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Logs & runtime
# -----------------------------------------------------------------------------
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
.hypothesis/
.benchmarks/
*.bak
*.tmp

# -----------------------------------------------------------------------------
# CLI Tools & Local Databases
# -----------------------------------------------------------------------------
# If you ever use the Supabase CLI locally
.supabase/

# If you ever use the Cloudflare Wrangler CLI locally
.wrangler/

# Catch any accidental local SQLite database files generated during testing
*.db
*.sqlite3

# Catch NPM crash logs (npm creates these automatically if an install fails)
npm-debug.log*
yarn-debug.log*
yarn-error.log*